 "mwcustom": {
  "type": "Steps",
  "props": {
   "steps": [
    {
     "title": "Before next",
     "detail": "Read or create X-Correlation-ID, start a stopwatch, open a log scope"
    },
    {
     "title": "await next(context)",
     "detail": "The rest of the pipeline and the endpoint run"
    },
    {
     "title": "After next",
     "detail": "Log status code and duration, write audit row"
    },
    {
     "title": "Or short-circuit",
     "detail": "Set status, write response, return without calling next"
    },
    {
     "title": "Register",
     "detail": "app.UseMiddleware<T>() at the right place in Program.cs"
    }
   ]
  }
 },
